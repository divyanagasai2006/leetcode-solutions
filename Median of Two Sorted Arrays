class Solution:
    def findMedianSortedArrays(self, nums1: list[int], nums2: list[int]) -> float:
        if len(nums1)>len(nums2):
            nums1,nums2=nums2,nums1
        m=len(nums1)
        n=len(nums2)
        left=0
        right=m
        while left<=right:
            cut1=(left+right)//2
            cut2=(m+n+1)//2-cut1
            if cut1<m and nums2[cut2-1]>nums1[cut1]:
                left=cut1+1
            elif cut1>0 and nums1[cut1-1]>nums2[cut2]:
                right=cut1-1
            else:
                if cut1==0:
                    left_value=nums2[cut2-1]
                elif cut2==0:
                    left_value=nums1[cut1-1]
                else:
                    left_value=max(nums1[cut1-1],nums2[cut2-1])
                if(m+n)%2==1:
                    return left_value
                if cut1==m:
                    right_value=nums2[cut2]
                elif cut2==n:
                    right_value=nums1[cut1]
                else:
                    right_value=min(nums1[cut1],nums2[cut2])
                return(left_value+right_value)/2
