class Solution:
    def leftRightDifference(self, nums: List[int]) -> List[int]:
        total=sum(nums)
        leftSum=0
        ans=[]
        for i in range(len(nums)):
            rightSum=total-leftSum-nums[i]
            ans.append(abs(leftSum-rightSum))
            leftSum+=nums[i]
        return ans
        
